{
  "note": "Canonical secret-pattern table. Hygiene check only, never a general guarantee. Block tier blocks publish/export; warning tier (email) warns only. Generic high-entropy pattern DROPPED (false positives). Identical embedded lists in site/agentcode.js and site/agentlang.js (verified by agentlang-tests SECRET_SOURCE_PASS); site/app.js, cloud/worker-v2/worker-v2.js and site/aiws mirror this table (field names + gates); build-check verifies the field list matches.",
  "patterns": [
    {
      "rule": "private-key",
      "tier": "block",
      "source": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "rule": "openai-key",
      "tier": "block",
      "source": "\\bsk-[A-Za-z0-9]{12,}"
    },
    {
      "rule": "stripe-key",
      "tier": "block",
      "source": "\\bsk_(live|test)_[A-Za-z0-9]{8,}"
    },
    {
      "rule": "github-token",
      "tier": "block",
      "source": "\\bgh[pous]_[A-Za-z0-9]{20,}"
    },
    {
      "rule": "aws-access-key-id",
      "tier": "block",
      "source": "\\bAKIA[0-9A-Z]{16}"
    },
    {
      "rule": "slack-token",
      "tier": "block",
      "source": "\\bxox[baprs]-[A-Za-z0-9-]{10,}"
    },
    {
      "rule": "jwt",
      "tier": "block",
      "source": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
    },
    {
      "rule": "api-key-assignment",
      "tier": "block",
      "source": "\\bapi[_-]?key\\s*[:=]\\s*\\S+"
    },
    {
      "rule": "access-token-assignment",
      "tier": "block",
      "source": "\\b(access[_-]?token|client[_-]?secret)\\s*[:=]\\s*\\S+"
    },
    {
      "rule": "password-assignment",
      "tier": "block",
      "source": "\\bpassword\\s*[:=]\\s*\\S+"
    },
    {
      "rule": "bearer-token",
      "tier": "block",
      "source": "\\bBearer\\s+[A-Za-z0-9._-]{12,}"
    },
    {
      "rule": "email-address",
      "tier": "warning",
      "source": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    }
  ]
}
